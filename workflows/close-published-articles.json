      "id": "bbc188b6-8bae-5ec9-8505-49d1d39c4a57",
      "name": "Read Article Control"
    },
    {
      "parameters": {
        "jsCode": "const clean = value => String(value ?? '').trim();\n\nconst monthCodes = {\n  January: 'JAN',\n  February: 'FEB',\n  March: 'MAR',\n  April: 'APR',\n  May: 'MAY',\n  June: 'JUN',\n  July: 'JUL',\n  August: 'AUG',\n  September: 'SEP',\n  October: 'OCT',\n  November: 'NOV',\n  December: 'DEC',\n};\n\nconst configurations =\n  $items('Read Account Configuration');\n\nconst configByAccount = new Map();\n\nfor (const item of configurations) {\n  const config = item.json;\n  const account = clean(config.account);\n\n  if (account) {\n    configByAccount.set(account, config);\n  }\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  const articleId = clean(row.article_id);\n  const account = clean(row.account);\n  const status = clean(row.status);\n  const url = clean(row.URL);\n\n  const publicationDate = clean(\n    row['actual_publication_date']\n  );\n\n  const calendarStatus = clean(\n    row['calendar_sync']\n  );\n\n  const paymentStatus = clean(\n    row['writer_log_sync']\n  );\n\n  if (\n    status !== 'Published' ||\n    !url ||\n    !publicationDate\n  ) {\n    continue;\n  }\n\n  const updateCalendar =\n    calendarStatus === 'Pending' ||\n    calendarStatus === 'Error';\n\n  const updatePayment =\n    paymentStatus === 'Pending' ||\n    paymentStatus === 'Error';\n\n  if (!updateCalendar && !updatePayment) {\n    continue;\n  }\n\n  const config = configByAccount.get(account);\n\n  if (!config) {\n    throw new Error(\n      `Missing configuration for: ${account}`\n    );\n  }\n\n  const clientType = clean(\n    config['client_type']\n  );\n\n  const destinationSpreadsheetId = clean(\n    config['destination_spreadsheet_id']\n  );\n\n  if (!destinationSpreadsheetId) {\n    throw new Error(\n      `Missing destination spreadsheet for: ${account}`\n    );\n  }\n\n  let destinationSheet;\n\n  if (clientType === 'direct') {\n    destinationSheet = clean(\n      config['destination_sheet']\n    );\n\n    if (!destinationSheet) {\n      throw new Error(\n        `Missing destination sheet for: ${account}`\n      );\n    }\n  } else {\n    const month = clean(row.month);\n    const monthCode = monthCodes[month];\n\n    if (!monthCode) {\n      throw new Error(\n        `Invalid month for ${articleId}: ${month}`\n      );\n    }\n\n    const yearMatch =\n      articleId.match(/^SEO-(\\d{4})-/);\n\n    if (!yearMatch) {\n      throw new Error(\n        `Cannot read year from ${articleId}`\n      );\n    }\n\n    const shortYear = yearMatch[1].slice(-2);\n\n    destinationSheet =\n      `BLOG POSTS - ${monthCode}${shortYear}`;\n  }\n\n  output.push({\n    json: {\n      ...row,\n      client_type: clientType,\n      destination_spreadsheet_id:\n        destinationSpreadsheetId,\n      destination_sheet: destinationSheet,\n      update_calendar: updateCalendar,\n      update_writer_log: updatePayment,\n    },\n    pairedItem:\n      item.pairedItem ?? { item: output.length },\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
