    {
      "parameters": {
        "jsCode": "const articleId =\n  $('Validate Assignment Candidates').item.json.article_id;\n\nconst card = ($json.cards ?? []).find(card =>\n  !card.closed &&\n  (card.desc ?? '').includes(`Control ID: ${articleId}`)\n);\n\nif (!card) {\n  throw new Error(\n    `Could not retrieve existing card for ${articleId}`\n  );\n}\n\nreturn [{ json: card }];"
      },
