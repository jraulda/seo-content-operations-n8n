      "id": "7ffd761d-406f-5e5b-ac6e-dcc2cb5b63d1",
      "name": "Read Article Control",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        256,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const clean = (value) => String(value ?? '').trim();\nconst parseDeliveryDate = (value) => {\n  const raw = clean(value);\n  const mexicanDate = raw.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n\n  if (mexicanDate) {\n    const [, dayText, monthText, yearText] = mexicanDate;\n    const day = Number(dayText);\n    const month = Number(monthText);\n    const year = Number(yearText);\n\n    const check = new Date(Date.UTC(year, month - 1, day));\n\n    if (\n      check.getUTCFullYear() !== year ||\n      check.getUTCMonth() !== month - 1 ||\n      check.getUTCDate() !== day\n    ) {\n      return null;\n    }\n\n    const isoDay = String(day).padStart(2, '0');\n    const isoMonth = String(month).padStart(2, '0');\n\n    return new Date(\n      String(year) + '-' + isoMonth + '-' + isoDay + 'T00:00:00Z'\n    );\n  }\n\n  const parsed = new Date(raw);\n  return Number.isNaN(parsed.getTime()) ? null : parsed;\n};\n\nconst configs = $items('Read Account Configuration');\nconst configByAccount = new Map();\n\nfor (const item of configs) {\n  const config = item.json;\n  const account = clean(config.account);\n  if (!account) continue;\n  configByAccount.set(account, config);\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const status = clean(row.status);\n  const cardId = clean(row['trello_card_id']);\n  if (status !== 'Ready to assign' || cardId) continue;\n\n  const calendarSync = clean(\n    row['calendar_sync']\n  );\n\n  const paymentSync = clean(\n    row['writer_log_sync']\n  );\n\n  if (\n    calendarSync !== 'Synced' ||\n    paymentSync !== 'Synced'\n  ) {\n    continue;\n  }\n\n  const required = {\n    article_id: clean(row.article_id),\n    account: clean(row.account),\n    topic: clean(row.topic),\n    primary_keyword: clean(row['primary_keyword']),\n    delivery_date: clean(row['delivery_date'])\n  };\n  const missing = Object.entries(required)\n    .filter(([, value]) => !value)\n    .map(([key]) => key);\n  if (missing.length) {\n    throw new Error(`Row ${row.row_number ?? '?'} is incomplete. Missing: ${missing.join(', ')}`);\n  }\n\n  const config = configByAccount.get(required.account);\n  if (!config) {\n    throw new Error(`Account is missing from account_config: ${required.account}`);\n  }\n  if (clean(config.active).toLowerCase() !== 'true') {\n    throw new Error(`Inactive account in account_config: ${required.account}`);\n  }\n\n  const labelId = clean(config['trello_label_id']);\n  if (!labelId) {\n    throw new Error(`Missing trello_label_id for: ${required.account}`);\n  }\n\n  const parsedDate = parseDeliveryDate(required.delivery_date);\n  if (!parsedDate) {\n    throw new Error(`Invalid delivery date for ${required.article_id}: ${required.delivery_date}`);\n  }\n\n  output.push({\n    json: {\n      ...row,\n      account_id: clean(config.account_id),\n      client_type: clean(config['client_type']),\n      destination_calendar: clean(config['destination_calendar']),\n      destination_spreadsheet_id: clean(config['destination_spreadsheet_id']),\n      destination_sheet: clean(config['destination_sheet']),\n      trello_label_name: clean(config['trello_label']),\n      trello_label_id: labelId,\n      trello_due: parsedDate.toISOString(),\n      trello_description: `**Primary keyword: ${required.primary_keyword}**\\n**Secondary keyword: ${clean(row['secondary_keyword'])}**${clean(row['category']) ? `\\n**Category:** ${clean(row['category'])}` : ''}\\n\\nControl ID: ${required.article_id}`\n    },\n    pairedItem: item.pairedItem ?? { item: output.length }\n  });\n}\n\nreturn output;"
      },
