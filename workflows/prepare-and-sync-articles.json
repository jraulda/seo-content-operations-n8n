      "id": "80085d81-1a3d-57f4-b1e5-5259f10736da",
      "name": "Read Article Control",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        256,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const clean = value => String(value ?? '').trim();\n\n// Account prefixes derive from account_id in account_config.\nconst prefixes = {};\n\nconst monthCodes = [\n  'JAN', 'FEB', 'MAR', 'APR',\n  'MAY', 'JUN', 'JUL', 'AUG',\n  'SEP', 'OCT', 'NOV', 'DEC',\n];\n\nfunction parseDate(value) {\n  const raw = clean(value);\n\n  let match = raw.match(\n    /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/\n  );\n\n  if (match) {\n    const day = Number(match[1]);\n    const month = Number(match[2]);\n    const year = Number(match[3]);\n\n    const check = new Date(\n      Date.UTC(year, month - 1, day)\n    );\n\n    if (\n      check.getUTCFullYear() !== year ||\n      check.getUTCMonth() !== month - 1 ||\n      check.getUTCDate() !== day\n    ) {\n      return null;\n    }\n\n    return { day, month, year };\n  }\n\n  match = raw.match(\n    /^(\\d{4})-(\\d{1,2})-(\\d{1,2})$/\n  );\n\n  if (match) {\n    const year = Number(match[1]);\n    const month = Number(match[2]);\n    const day = Number(match[3]);\n\n    const check = new Date(\n      Date.UTC(year, month - 1, day)\n    );\n\n    if (\n      check.getUTCFullYear() !== year ||\n      check.getUTCMonth() !== month - 1 ||\n      check.getUTCDate() !== day\n    ) {\n      return null;\n    }\n\n    return { day, month, year };\n  }\n\n  return null;\n}\n\n\n// ======================================================\n// Account configuration\n// ======================================================\n\nconst configurationItems =\n  $items('Read Account Configuration');\n\nconst configByAccount = new Map();\n\nfor (const item of configurationItems) {\n  const config = item.json;\n  const account = clean(config.account);\n\n  if (account) {\n    configByAccount.set(account, config);\n  }\n}\n\n\n// ======================================================\n// Existing IDs and sequences\n// ======================================================\n\nconst rows = $input.all();\nconst usedIds = new Set();\nconst maximumSequence = new Map();\n\nfor (const item of rows) {\n  const articleId = clean(item.json.article_id);\n\n  if (!articleId) continue;\n\n  if (usedIds.has(articleId)) {\n    throw new Error(\n      `Duplicate article_id in master: ${articleId}`\n    );\n  }\n\n  usedIds.add(articleId);\n\n  const match = articleId.match(\n    /^SEO-(\\d{4})-(\\d{2})-([A-Z0-9]+)-(\\d+)$/\n  );\n\n  if (!match) continue;\n\n  const key =\n    `${match[1]}-${match[2]}-${match[3]}`;\n\n  const sequence = Number(match[4]);\n\n  maximumSequence.set(\n    key,\n    Math.max(\n      maximumSequence.get(key) ?? 0,\n      sequence\n    )\n  );\n}\n\n\n// ======================================================\n// Prepare articles\n// ======================================================\n\nconst output = [];\n\nfor (const item of rows) {\n  const row = item.json;\n  const status = clean(row.status);\n\n  if (status !== 'Ready to assign') {\n    continue;\n  }\n\n  const calendarSync = clean(\n    row['calendar_sync']\n  );\n\n  const paymentSync = clean(\n    row['writer_log_sync']\n  );\n\n  if (\n    calendarSync === 'Synced' &&\n    paymentSync === 'Synced'\n  ) {\n    continue;\n  }\n\n  const account = clean(row.account);\n  const topic = clean(row.topic);\n  const primaryKeyword = clean(\n    row['primary_keyword']\n  );\n\n  const plannedDate = parseDate(\n    row['planned_date']\n  );\n\n  if (!account || !topic || !primaryKeyword) {\n    throw new Error(\n      `Row ${row.row_number ?? '?'} is incomplete. ` +\n      `Account, topic, and primary keyword are required.`\n    );\n  }\n\n  if (!plannedDate) {\n    throw new Error(\n      `Invalid planned date in row ` +\n      `${row.row_number ?? '?'}: ` +\n      `${clean(row['planned_date'])}`\n    );\n  }\n\n  const config = configByAccount.get(account);\n\n  if (!config) {\n    throw new Error(\n      `Missing configuration for: ${account}`\n    );\n  }\n\n  if (\n    clean(config.active).toLowerCase() !== 'true'\n  ) {\n    throw new Error(\n      `Inactive account: ${account}`\n    );\n  }\n\n  const accountId = clean(config.account_id);\n  const prefix =\n    prefixes[accountId] ||\n    accountId.replace(/[^a-z0-9]/gi, '').toUpperCase();\n\n  if (!prefix) {\n    throw new Error(\n      `Cannot determine ID prefix for: ${account}`\n    );\n  }\n\n  const year = String(plannedDate.year);\n  const month = String(\n    plannedDate.month\n  ).padStart(2, '0');\n\n  const sequenceKey =\n    `${year}-${month}-${prefix}`;\n\n  let articleId = clean(row.article_id);\n  let generatedArticleId = false;\n\n  if (!articleId) {\n    if (\n      calendarSync === 'Synced' ||\n      paymentSync === 'Synced'\n    ) {\n      throw new Error(\n        `Row ${row.row_number ?? '?'} is marked as ` +\n        `synced but has no article_id.`\n      );\n    }\n\n    const nextSequence =\n      (maximumSequence.get(sequenceKey) ?? 0) + 1;\n\n    maximumSequence.set(\n      sequenceKey,\n      nextSequence\n    );\n\n    articleId =\n      `SEO-${year}-${month}-${prefix}-` +\n      String(nextSequence).padStart(2, '0');\n\n    if (usedIds.has(articleId)) {\n      throw new Error(\n        `Attempted duplicate article ID: ${articleId}`\n      );\n    }\n\n    usedIds.add(articleId);\n    generatedArticleId = true;\n  }\n\n  const clientType = clean(\n    config['client_type']\n  );\n\n  const destinationSpreadsheetId = clean(\n    config['destination_spreadsheet_id']\n  );\n\n  let destinationSheet;\n\n  if (clientType === 'direct') {\n    destinationSheet = clean(\n      config['destination_sheet']\n    );\n  } else {\n    const monthCode =\n      monthCodes[plannedDate.month - 1];\n\n    const shortYear =\n      year.slice(-2);\n\n    destinationSheet =\n      `BLOG POSTS - ${monthCode}${shortYear}`;\n  }\n\n  if (\n    !destinationSpreadsheetId ||\n    !destinationSheet\n  ) {\n    throw new Error(\n      `Missing destination calendar or sheet for: ${account}`\n    );\n  }\n\n  output.push({\n    json: {\n      ...row,\n      article_id: articleId,\n      article_id_generated: generatedArticleId,\n      account_id: accountId,\n      client_type: clientType,\n      destination_spreadsheet_id:\n        destinationSpreadsheetId,\n      destination_sheet: destinationSheet,\n      update_calendar:\n        calendarSync !== 'Synced',\n      update_writer_log:\n        paymentSync !== 'Synced',\n    },\n    pairedItem:\n      item.pairedItem ?? { item: output.length },\n  });\n}\n\nreturn output;"
      },
