      "name": "Read Agency Calendar"
    },
    {
      "parameters": {
        "jsCode": "const clean = value =>\n  String(value ?? '').trim();\n\nconst normalize = value =>\n  clean(value)\n    .normalize('NFD')\n    .replace(/\\p{Diacritic}/gu, '')\n    .toLowerCase();\n\nconst sheetRows = [\n  ...new Map(\n    $input.all().map(item => [\n      Number(item.json.row_number),\n      item.json,\n    ])\n  ).values(),\n];\n\nconst candidates =\n  $items('Restore Prepared Article')\n    .map(item => item.json)\n    .filter(item =>\n      item.client_type === 'agency' &&\n      item.update_calendar === true\n    );\n\nif (!candidates.length) {\n  return [];\n}\n\n\n// ======================================================\n// One destination spreadsheet and monthly sheet per execution\nconst destinationIds = [...new Set(candidates.map(item => clean(item.destination_spreadsheet_id)))];\nif (destinationIds.length !== 1) throw new Error('Batch contains multiple destination spreadsheets. Run each separately.');\n// ======================================================\n\nconst destinationSheets = [\n  ...new Set(\n    candidates.map(item =>\n      clean(item.destination_sheet)\n    )\n  )\n];\n\nif (destinationSheets.length !== 1) {\n  throw new Error(\n    'Batch contains multiple monthly sheets: ' +\n    destinationSheets.join(', ') +\n    '. Run each month separately.'\n  );\n}\n\nlet headerRows = sheetRows\n  .filter(row =>\n    clean(row.topic) === 'topic'\n  )\n  .map(row => ({\n    rowNumber: Number(row.row_number),\n    values: Object.values(row)\n      .map(normalize)\n      .filter(Boolean),\n    raw: row,\n  }));\n\n\n// ======================================================\n// Recover first account header used as column names by n8n\n// ======================================================\n\nconst schemaRow = sheetRows.find(row =>\n  Object.keys(row).some(column =>\n    normalize(column) === 'topic'\n  )\n);\n\nconst returnedRowNumbers = sheetRows\n  .map(row => Number(row.row_number))\n  .filter(Number.isFinite);\n\nif (\n  schemaRow &&\n  returnedRowNumbers.length\n) {\n  const columnNames =\n    Object.keys(schemaRow);\n\n  const topicColumnIndex =\n    columnNames.findIndex(column =>\n      normalize(column) === 'topic'\n    );\n\n  const firstAccountName =\n    topicColumnIndex > 0\n      ? columnNames[topicColumnIndex - 1]\n      : '';\n\n  const firstHeaderRowNumber =\n    Math.min(...returnedRowNumbers) - 1;\n\n  if (\n    firstAccountName &&\n    !headerRows.some(header =>\n      header.values.includes(\n        normalize(firstAccountName)\n      )\n    )\n  ) {\n    headerRows.push({\n      rowNumber: firstHeaderRowNumber,\n      values: [\n        normalize(firstAccountName),\n        'topic',\n      ],\n      raw: {},\n    });\n  }\n}\n\nheaderRows.sort(\n  (a, b) => a.rowNumber - b.rowNumber\n);\n\nconst output = [];\n\nfor (\n  let candidateIndex = 0;\n  candidateIndex < candidates.length;\n  candidateIndex++\n) {\n  const candidate = candidates[candidateIndex];\n\n  const articleId =\n    clean(candidate.article_id);\n\n  const topic =\n    clean(candidate.topic);\n\n  const account =\n    clean(candidate.account);\n\n\n  // ====================================================\n  // 1. Prefer existing article_id\n  // ====================================================\n\n  let target = sheetRows.find(row =>\n    clean(row.article_id) === articleId\n  );\n\n  let matchedBy = 'article_id';\n\n\n  // ====================================================\n  // 2. Otherwise match the exact article title\n  // ====================================================\n\n  if (!target) {\n    target = sheetRows.find(row =>\n      normalize(row.topic) === normalize(topic) &&\n      normalize(row.topic) !== 'topic'\n    );\n\n    matchedBy = 'topic';\n  }\n\n\n  // ====================================================\n  // 3. Otherwise calculate row from account + sequence\n  // ====================================================\n\n  if (!target) {\n    const accountHeaderIndex =\n      headerRows.findIndex(header =>\n        header.values.includes(\n          normalize(account)\n        )\n      );\n\n    if (accountHeaderIndex === -1) {\n      throw new Error(\n        `Cannot find account section for ${account}`\n      );\n    }\n\n    const accountHeader =\n      headerRows[accountHeaderIndex];\n\n    const nextHeader =\n      headerRows[accountHeaderIndex + 1];\n\n    const sequenceMatch =\n      articleId.match(/-(\\d+)$/);\n\n    if (!sequenceMatch) {\n      throw new Error(\n        `Cannot read sequence from ${articleId}`\n      );\n    }\n\n    const sequence =\n      Number(sequenceMatch[1]);\n\n    const targetRowNumber =\n      accountHeader.rowNumber + sequence;\n\n    if (\n      nextHeader &&\n      targetRowNumber >= nextHeader.rowNumber\n    ) {\n      throw new Error(\n        `${articleId} is outside the section ` +\n        `reserved for ${account}`\n      );\n    }\n\n    target =\n      sheetRows.find(row =>\n        Number(row.row_number) ===\n        targetRowNumber\n      ) || {\n        row_number: targetRowNumber\n      };\n\n    const existingId =\n      clean(target.article_id);\n\n    const existingTopic =\n      clean(target.topic);\n\n    if (\n      existingId &&\n      existingId !== articleId\n    ) {\n      throw new Error(\n        `Row ${targetRowNumber} already contains ` +\n        `another article_id: ${existingId}`\n      );\n    }\n\n    if (\n      existingTopic &&\n      normalize(existingTopic) !==\n        normalize(topic)\n    ) {\n      throw new Error(\n        `Row ${targetRowNumber} already contains ` +\n        `another topic: ${existingTopic}`\n      );\n    }\n\n    matchedBy = 'section and sequence';\n  }\n\n  output.push({\n    json: {\n      ...candidate,\n      agency_row_number:\n        Number(target.row_number),\n      agency_match_method: matchedBy,\n    },\n    pairedItem: {\n      item: candidateIndex,\n    },\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
